#!/usr/bin/env bash
# ==============================================================================
# CPUGhost Universal CLI Launcher (Compatible with Linux, Zorin OS & Termux)
# ==============================================================================
set -e

# Universal PATH setup
export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:/usr/local/bin:/usr/bin:${PATH}"
if [ -d "/data/data/com.termux/files/usr/bin" ]; then
    export PATH="/data/data/com.termux/files/usr/bin:${HOME}/bin:${PATH}"
fi

# Dynamically resolve symlinks and project directory
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE%/*}" = "$SOURCE" ] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_DIR="$( cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd )"

# Fallback: if project root is where the script is located
if [ ! -d "${PROJECT_DIR}/cpughost" ] && [ -d "${SCRIPT_DIR}/cpughost" ]; then
    PROJECT_DIR="${SCRIPT_DIR}"
fi

# Ensure XDG_RUNTIME_DIR
if [ -z "$XDG_RUNTIME_DIR" ]; then
    UID_NUM="$(id -u 2>/dev/null || echo 1000)"
    if [ -d "/run/user/${UID_NUM}" ]; then
        export XDG_RUNTIME_DIR="/run/user/${UID_NUM}"
    fi
fi

# Ensure DISPLAY
if [ -z "$DISPLAY" ]; then
    for num in 0 1 2 99; do
        if [ -S "/tmp/.X11-unix/X${num}" ]; then
            export DISPLAY=":${num}"
            break
        fi
    done
    if [ -z "$DISPLAY" ]; then
        export DISPLAY=":0"
    fi
fi

# Ensure XAUTHORITY
if [ -z "$XAUTHORITY" ]; then
    UID_NUM="$(id -u 2>/dev/null || echo 1000)"
    run_dir="/run/user/${UID_NUM}"
    if [ -d "$run_dir" ]; then
        MATCH="$(ls -1 "$run_dir"/.mutter-Xwaylandauth* "$run_dir"/*xauth* 2>/dev/null | head -n 1 || true)"
        if [ -n "$MATCH" ]; then
            export XAUTHORITY="$MATCH"
        fi
    fi
    if [ -z "$XAUTHORITY" ] && [ -f "${HOME}/.Xauthority" ]; then
        export XAUTHORITY="${HOME}/.Xauthority"
    fi
fi

export PYGAME_HIDE_SUPPORT_PROMPT="1"
export PYTHONPATH="${PROJECT_DIR}:${PYTHONPATH}"

# In Termux/Android, use system python3 directly
if [ -n "$TERMUX_VERSION" ] || [ -d "/data/data/com.termux/files" ]; then
    exec python3 -m cpughost.cli "$@"
fi

# Standard Linux (Zorin OS / PC zero) Virtual Environment
VENV_DIR="${PROJECT_DIR}/.venv"
VENV_PYTHON="${VENV_DIR}/bin/python"

if [ ! -f "$VENV_PYTHON" ]; then
    echo "[INFO] CPUGhost Python environment not found at ${VENV_PYTHON}"
    echo "[INFO] Auto-bootstrapping dependencies..."
    DEPS="fastapi uvicorn websockets mss pillow pynput requests rich click pygame-ce python-multipart httpx"

    # Locate or install uv
    UV_BIN="$(command -v uv || true)"
    if [ -z "$UV_BIN" ] && [ -x "${HOME}/.local/bin/uv" ]; then
        UV_BIN="${HOME}/.local/bin/uv"
    elif [ -z "$UV_BIN" ] && [ -x "${HOME}/.cargo/bin/uv" ]; then
        UV_BIN="${HOME}/.cargo/bin/uv"
    fi

    if [ -z "$UV_BIN" ] && command -v curl >/dev/null 2>&1; then
        echo "[INFO] Bootstrapping standalone uv package manager..."
        curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null 2>&1 || true
        export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:${PATH}"
        UV_BIN="$(command -v uv || true)"
        [ -z "$UV_BIN" ] && [ -x "${HOME}/.local/bin/uv" ] && UV_BIN="${HOME}/.local/bin/uv"
        [ -z "$UV_BIN" ] && [ -x "${HOME}/.cargo/bin/uv" ] && UV_BIN="${HOME}/.cargo/bin/uv"
    fi

    if [ -n "$UV_BIN" ] && [ -x "$UV_BIN" ]; then
        echo "[INFO] Initializing virtual environment using uv..."
        "$UV_BIN" venv "${VENV_DIR}" --seed --allow-existing
        "$UV_BIN" pip install --python "${VENV_PYTHON}" $DEPS
    elif command -v python3 >/dev/null 2>&1; then
        echo "[INFO] Initializing virtual environment using python3..."
        if python3 -m venv "${VENV_DIR}" 2>/dev/null; then
            "${VENV_DIR}/bin/pip" install --upgrade pip setuptools wheel 2>/dev/null || true
            "${VENV_DIR}/bin/pip" install $DEPS
        else
            echo "[WARN] python3-venv missing. Attempting pip user install fallback..."
            python3 -m pip install --user $DEPS 2>/dev/null || true
            exec python3 -m cpughost.cli "$@"
        fi
    else
        echo "[ERR] Neither uv nor python3 is available. Run ./setup.sh first."
        exit 1
    fi
    echo "[OK] CPUGhost environment successfully initialized."
fi

exec "$VENV_PYTHON" -m cpughost.cli "$@"
