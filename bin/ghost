#!/usr/bin/env bash
# ==============================================================================
# CPUGhost Universal CLI Launcher
# ==============================================================================
set -e

# Dynamically resolve symlinks to find project directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_DIR="$( cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd )"

# Ensure ~/.local/bin is in PATH for uv and other tools
export PATH="${HOME}/.local/bin:${PATH}"

# Ensure DISPLAY and XAUTHORITY if available
if [ -z "$DISPLAY" ] && [ -S "/tmp/.X11-unix/X0" ]; then
    export DISPLAY=":0"
fi

if [ -z "$XAUTHORITY" ]; then
    UID_NUM="$(id -u)"
    if compgen -G "/run/user/${UID_NUM}/.mutter-Xwaylandauth*" > /dev/null; then
        export XAUTHORITY="$(ls -1 /run/user/${UID_NUM}/.mutter-Xwaylandauth* 2>/dev/null | head -n 1)"
    elif [ -f "${HOME}/.Xauthority" ]; then
        export XAUTHORITY="${HOME}/.Xauthority"
    fi
fi

VENV_DIR="${PROJECT_DIR}/.venv"
VENV_PYTHON="${VENV_DIR}/bin/python"

if [ ! -f "$VENV_PYTHON" ]; then
    echo "[INFO] Virtual environment not found at ${VENV_PYTHON}"
    echo "[INFO] Initializing CPUGhost Python environment..."
    DEPS="fastapi uvicorn websockets mss pillow pynput requests rich click pygame-ce python-multipart httpx"
    if command -v uv >/dev/null 2>&1; then
        uv venv "${VENV_DIR}"
        uv pip install --python "${VENV_PYTHON}" $DEPS
    else
        python3 -m venv "${VENV_DIR}"
        "${VENV_DIR}/bin/pip" install --upgrade pip setuptools wheel
        "${VENV_DIR}/bin/pip" install $DEPS
    fi
    echo "[OK] CPUGhost environment successfully initialized."
fi

export PYGAME_HIDE_SUPPORT_PROMPT="1"
export PYTHONPATH="${PROJECT_DIR}:${PYTHONPATH}"
exec "$VENV_PYTHON" -m cpughost.cli "$@"
